# Firebase Web App config — lấy từ Firebase Console > Project settings > Your apps (Web)
# Sao chép file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
